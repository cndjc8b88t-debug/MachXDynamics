<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1014">
    <title>{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.tagline }}">
    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
    {% if noindex or site.draft %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% if site.draft %}<div class="draft-banner" role="note">DRAFT · not published · legal texts pending review</div>{% endif %}
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
