<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1014">
    {% set pageTitle %}{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.seoTitle or site.appName }}{% endif %}{% endset %}
    {% set pageDescription = description or site.tagline %}
    {% set pageUrl = site.baseUrl + page.url %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}">
    {# canonical in front matter points a duplicate page at its original (e.g. /imprint/ -> /impressum/). #}
    <link rel="canonical" href="{% if canonical %}{{ site.baseUrl }}{{ canonical }}{% else %}{{ pageUrl }}{% endif %}">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="apple-itunes-app" content="app-id={{ site.appStoreId }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:locale" content="{% if pageLang == 'de' %}de_DE{% else %}en_US{% endif %}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    <meta property="og:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta property="og:image:width" content="1434">
    <meta property="og:image:height" content="660">
    <meta property="og:image:alt" content="{{ site.ogImageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    <meta name="twitter:image" content="{{ site.baseUrl }}{{ site.ogImage }}">
    <meta name="twitter:image:alt" content="{{ site.ogImageAlt }}">
    {% if noindex or site.draft %}<meta name="robots" content="noindex">{% endif %}
    {% if page.url == "/" %}{% include "jsonld.njk" %}{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% if site.draft %}<div class="draft-banner" role="note">DRAFT · not published · legal texts pending review</div>{% endif %}
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
