<!doctype html>
<html lang="{{ pageLang or site.language }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0d1014">
    {% set pageTitle %}{% if title %}{{ title }} · {{ site.title }}{% else %}{{ site.appName }}{% endif %}{% endset %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or site.tagline }}">
    <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ description or site.tagline }}">
    <meta property="og:url" content="{{ site.baseUrl }}{{ page.url }}">
    <meta property="og:image" content="{{ site.baseUrl }}/assets/img/app-nozzle-mach-1434.jpg">
    <meta property="og:image:width" content="1434">
    <meta property="og:image:height" content="660">
    <meta property="og:image:alt" content="The MachXDynamics app on iPhone, showing Mach number in a nozzle and the jet behind it, with the label 2D · inviscid · no chemistry · qualitative.">
    {% if noindex or site.draft %}<meta name="robots" content="noindex">{% endif %}
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
    {% if site.draft %}<div class="draft-banner" role="note">DRAFT · not published · legal texts pending review</div>{% endif %}
    {% include "header.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>
